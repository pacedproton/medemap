# MeDeMAP Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ==============================================================================
# CESIUM CONFIGURATION
# ==============================================================================
# Get your token from https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_ION_ACCESS_TOKEN=your_cesium_token_here

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_DB=cmc
POSTGRES_PORT=5432

# Legacy database connection (for knexfile.js compatibility)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=cmc

# ==============================================================================
# NEXTAUTH CONFIGURATION
# ==============================================================================
# For local development: http://localhost:3000
# For production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# ==============================================================================
# LLM API CONFIGURATION (Optional)
# ==============================================================================
# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama Configuration (for local/remote Ollama instances)
# For local: http://localhost:11434
# For remote: http://your-ollama-server:11434
OLLAMA_URL=http://localhost:11434

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Node environment: development, production, test
NODE_ENV=development

# ==============================================================================
# KUBERNETES DEPLOYMENT NOTES
# ==============================================================================
# When deploying to Kubernetes:
# 1. Set NEXTAUTH_URL to your public ingress URL
# 2. Set POSTGRES_HOST to your PostgreSQL service name (e.g., postgres-service)
# 3. Store all secrets in Kubernetes Secrets
# 4. Use ConfigMaps for non-sensitive configuration

# AI research assistant access
# One shared secret for everyone: users type it in the assistant's access dialog and the
# server compares it with this value. At least 16 characters; create one with:
#   openssl rand -base64 24
# People ask for the key by email; the address shown in the dialog is lib/ai/contact.ts.
AI_ACCESS_KEY=
